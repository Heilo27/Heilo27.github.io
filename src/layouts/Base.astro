---
// The one layout. Props CONTRACT (the Radial page depends on it; keep it exactly):
//   title?: page title (gets " | HeiloProjects" unless it already names the studio)
//   description?: meta description (defaults to the studio description)
//   app?: app slug; sets data-app on <html>, which switches every colour token to that app's world
//   image?: OG image, root-relative or absolute (defaults to /og.png)
// Page-specific JSON-LD or preloads go in the "head" slot.
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { appBySlug } from '../data/apps';
import { themeVar, hasTheme } from '../lib/themes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Menu from '../components/Menu.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  app?: string;
  image?: string;
}
const { title, description = site.description, app, image = '/og.png' } = Astro.props;
const theme = hasTheme(app) ? app : undefined;
const fullTitle = !title ? `${site.name}: ${site.role}` : title.includes(site.name) ? title : `${title} | ${site.name}`;
const base = Astro.site ?? site.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const appEntry = app ? appBySlug(app) : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#studio`,
      name: site.name,
      url: site.url,
      email: `mailto:${site.email}`,
      founder: { '@type': 'Person', name: site.person, url: site.url },
      sameAs: [site.appStoreDeveloper, site.github],
    },
    { '@type': 'WebPage', '@id': canonical, url: canonical, name: fullTitle, description, isPartOf: { '@id': `${site.url}/#studio` } },
  ],
};
---
<!doctype html>
<html lang="en" transition:animate="none" data-app={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={themeVar(theme, '--c-bg')} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/mona-200_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <div id="cursor" transition:persist="cursor" aria-hidden="true"><span data-cursor-label></span></div>
    <div class="page" data-page>
      <Header app={appEntry} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Footer app={appEntry} />
    </div>
    <Menu app={appEntry} />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
