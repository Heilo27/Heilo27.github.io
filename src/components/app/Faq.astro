---
// Questions, as native disclosure widgets: keyboard and screen readers get them for free, the
// height animates in CSS where the browser supports it, and with no JS they still open.
import type { App } from '../../data/apps';

interface Props { app: App }
const { app } = Astro.props;
---
<section class="afaq wrap section" aria-labelledby="faq-h">
  <h2 id="faq-h" class="display afaq__h" data-split="lines">Questions</h2>
  <div class="afaq__list">
    {app.faq.map((f) => (
      <details class="afaq__item" name="faq">
        <summary class="afaq__q"><span class="h-m">{f.q}</span><span class="afaq__sign" aria-hidden="true"></span></summary>
        <div class="afaq__a"><p class="body muted">{f.a}</p></div>
      </details>
    ))}
  </div>
</section>
