---
// Footer as finale, in the ink world. The form writes an email: with JS it composes a clean
// subject and body (src/motion/home.ts); without JS the browser submits it as a mailto: link,
// and the select and textarea are named subject and body so mail apps still pick them up.
import { site, contact } from '../../data/site';
import { contactUi as ui } from './copy';
---
<section id="contact" class="contact" data-world="ink" aria-labelledby="contact-title">
  <div class="contact__grid wrap">
    <div class="contact__intro">
      <h2 id="contact-title" class="contact__title display" data-split="lines">{contact.title}</h2>
      <p class="contact__text lede" data-reveal="fade">{contact.text}</p>
      <p class="contact__direct">
        <span class="muted">{ui.direct}</span>
        <a class="contact__mail" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <form
      class="form"
      action={`mailto:${site.email}`}
      method="get"
      data-mail-form
      data-to={site.email}
      data-subject={ui.subject}
      data-reveal="up"
    >
      <div class="field">
        <label class="field__label" for="f-name">{ui.fields.name}</label>
        <input class="field__input" id="f-name" name="name" type="text" autocomplete="name" required data-error={ui.errors.name} aria-describedby="f-name-err" />
        <p class="field__error" id="f-name-err" data-error-for="f-name"></p>
      </div>
      <div class="field">
        <label class="field__label" for="f-email">{ui.fields.email}</label>
        <input class="field__input" id="f-email" name="email" type="email" autocomplete="email" inputmode="email" spellcheck="false" required data-error={ui.errors.email} aria-describedby="f-email-err" />
        <p class="field__error" id="f-email-err" data-error-for="f-email"></p>
      </div>
      <div class="field field--wide">
        <label class="field__label" for="f-kind">{ui.fields.kind}</label>
        <span class="field__select">
          <select class="field__input" id="f-kind" name="subject">
            {contact.kinds.map((k) => <option value={k}>{k}</option>)}
          </select>
        </span>
      </div>
      <div class="field field--wide">
        <label class="field__label" for="f-details">{ui.fields.details}</label>
        <textarea class="field__input field__area" id="f-details" name="body" rows="5" required minlength="10" data-error={ui.errors.details} aria-describedby="f-details-hint f-details-err"></textarea>
        <p class="field__hint" id="f-details-hint">{ui.hints.details}</p>
        <p class="field__error" id="f-details-err" data-error-for="f-details"></p>
      </div>
      <div class="form__send field--wide">
        <button class="btn" type="submit">{ui.submit}<span class="btn__arrow" aria-hidden="true">→</span></button>
        <p class="form__note muted" id="f-note">{ui.note}</p>
      </div>
    </form>
  </div>
</section>
