---
// The VOR receiver, drawn after the app's own: DME (amber) and CRS (cyan) readouts in B612 Mono,
// a status chip, and the CDI: an OBS card that turns so the selected course sits under the top
// index, five dots each side (2° a dot, ±10° full scale), the needle, and the TO/FROM/OFF window.
import { computeVOR, describe, dmeFeet, dotsOf, formatCourse } from './vor';
import { U, type Pose } from './walk';

interface Props { pose: Pose }
const { pose } = Astro.props;
const v = computeVOR(pose.e, pose.n, U, pose.obs);
const DOT = 12; // units per dot on the face
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
const labels = ['N', '3', '6', 'E', '12', '15', 'S', '21', '24', 'W', '30', '33'];
// The decimal point gets its own narrow cell: in a monospace face a full-width '.' reads '6. 0'.
const dme = dmeFeet(v.slantM).split('.');
const chip = v.off === 'cone' ? 'CONE' : v.off === 'abeam' ? 'ABEAM' : '';
---
<div class="rd-rx" data-rd-rx role="img" aria-label={`VOR receiver. ${describe(v, pose.obs)}`}>
  <div class="rd-rx__row">
    <p class="rd-rx__box">
      <span class="rd-rx__k">DME</span>
      <span class="rd-rx__v rd-rx__v--dme"><span data-rd-dme-i>{dme[0]}</span><span class="rd-rx__dp">.</span><span data-rd-dme-f>{dme[1]}</span></span>
      <span class="rd-rx__u">FT</span>
    </p>
    <span class="rd-rx__chip" data-rd-chip hidden={!chip}>{chip || 'CONE'}</span>
    <p class="rd-rx__box rd-rx__box--crs">
      <span class="rd-rx__k">CRS</span>
      <span class="rd-rx__v rd-rx__v--crs" data-rd-crs>{formatCourse(pose.obs)}</span>
    </p>
  </div>

  <svg class="rd-cdi" viewBox="-130 -130 260 260" aria-hidden="true" focusable="false">
    <defs>
      <filter id="rd-needle-glow" x="-200%" y="-20%" width="500%" height="140%">
        <feGaussianBlur stdDeviation="2.2" result="b" />
        <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
      </filter>
      <pattern id="rd-off-stripes" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="8" height="8" fill="#f4f4f4" />
        <rect width="4" height="8" fill="#ff5a4e" />
      </pattern>
    </defs>
    <rect class="rd-cdi__bezel" x="-126" y="-126" width="252" height="252" rx="22" />
    <circle class="rd-cdi__face" r="112" />
    <circle class="rd-cdi__rim" r="112" />

    <g class="rd-cdi__card" data-rd-card transform={`rotate(${-pose.obs})`}>
      {ticks.map((a) => {
        const len = a % 30 === 0 ? 14 : a % 10 === 0 ? 10 : 6;
        return <line x1="0" y1="-106" x2="0" y2={-106 + len} transform={`rotate(${a})`} class={a % 10 === 0 ? 'is-major' : undefined} />;
      })}
      {labels.map((t, i) => <text transform={`rotate(${i * 30}) translate(0 -79)`}>{t}</text>)}
    </g>

    <path class="rd-cdi__index" d="M0,-100 l-8,-13 h16 z" />
    <path class="rd-cdi__index rd-cdi__index--recip" d="M0,100 l-7,12 h14 z" />

    <g class="rd-cdi__dots">
      {[-5, -4, -3, -2, -1, 1, 2, 3, 4, 5].map((d) => <circle cx={d * DOT} r="3.2" />)}
      <circle class="rd-cdi__centre" r="7" />
    </g>
    <text class="rd-cdi__name" y="44">VOR</text>

    <g class="rd-cdi__flag" transform="translate(34 -44)">
      <g data-rd-flag="TO" visibility={v.flag === 'TO' ? 'visible' : 'hidden'}>
        <rect class="rd-cdi__flagbox" x="-20" y="-11" width="48" height="22" rx="3" />
        <path d="M-12,5 l6,-11 l6,11 z" class="rd-cdi__tri" />
        <text x="13" y="4.5">TO</text>
      </g>
      <g data-rd-flag="FROM" visibility={v.flag === 'FROM' ? 'visible' : 'hidden'}>
        <rect class="rd-cdi__flagbox" x="-20" y="-11" width="48" height="22" rx="3" />
        <path d="M-15,-5 l6,11 l6,-11 z" class="rd-cdi__tri" />
        <text x="11" y="4.5">FROM</text>
      </g>
      <g data-rd-flag="OFF" visibility={v.flag === 'OFF' ? 'visible' : 'hidden'}>
        <rect x="-20" y="-11" width="48" height="22" rx="2" fill="url(#rd-off-stripes)" />
        <rect class="rd-cdi__offlabel" x="-9" y="-7" width="26" height="14" rx="1" />
        <text class="rd-cdi__offtext" x="4" y="4">OFF</text>
      </g>
    </g>

    <g data-rd-needle transform={`translate(${(dotsOf(v.needle) * DOT).toFixed(2)} 0)`}>
      <rect class="rd-cdi__needle" x="-2.6" y="-66" width="5.2" height="132" rx="2.6" filter="url(#rd-needle-glow)" />
    </g>

    <g class="rd-cdi__knob" transform="translate(-100 100)">
      <circle r="13" />
      {Array.from({ length: 16 }, (_, i) => <line x1="0" y1="-12" x2="0" y2="-8" transform={`rotate(${i * 22.5})`} />)}
    </g>
    <text class="rd-cdi__obs" x="-80" y="114">OBS</text>
  </svg>
</div>
