---
// A real app screenshot in an iPhone-shaped frame. Devices keep their own radius (DESIGN.md shape rule).
import { Image } from 'astro:assets';
import type { Shot } from '../../data/apps';

interface Props { shot: Shot; width: number; caption?: string; class?: string; eager?: boolean }
const { shot, width, caption, class: cls = '', eager = false } = Astro.props;
---
<figure class:list={['rd-phone', cls]} style={`--w:${width}px`}>
  <div class="rd-phone__body">
    <Image src={shot.src} alt={shot.alt} width={width} densities={[1, 2]} format="webp" quality={80}
      loading={eager ? 'eager' : 'lazy'} decoding="async" class="rd-phone__screen" />
  </div>
  {caption && <figcaption class="rd-phone__cap">{caption}</figcaption>}
</figure>
