---
// The HeiloProjects mark: four Home Screen slots, three filled and one waiting (the "Your app" slot).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class:list={['mark', cls]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="10" height="10" rx="2.3" fill="currentColor" />
  <rect x="13" y="1" width="10" height="10" rx="2.3" fill="currentColor" />
  <rect x="1" y="13" width="10" height="10" rx="2.3" fill="currentColor" />
  <rect x="13.75" y="13.75" width="8.5" height="8.5" rx="1.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.2 1.6" />
</svg>
